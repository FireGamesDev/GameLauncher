<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Title="Launcher" Height="576" Width="1080">
    <Grid>
        <Image Stretch="UniformToFill" Source="LauncherBackground.jpg"/>
        <TextBlock Name="blackImage" Visibility="Hidden" Background="Black" Margin="312,302,314,99"></TextBlock>
        <TextBlock Name="downloadedAmountText" Visibility="Hidden" VerticalAlignment="Center" TextAlignment="Center" FontSize="20" Background="Black" Foreground="White"  Margin="352,384,382,123" Height="38"/>
        <ProgressBar Width="300" Height="40" Visibility="Hidden" x:Name="progressBar" Value="0" Minimum="0" Maximum="100" Margin="382,344,390,161" RenderTransformOrigin="0.53,3.175" Background="Black" Foreground="White" BorderBrush="Black"/>
        <TextBlock Name="VersionText" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="14" Foreground="White" Margin="0, 0, 5, 0"/>
        <Button Name="PlayButton" Content="Checking For Updates..." Click="PlayButton_Click" Height="60" FontSize="28" FontWeight="Bold" Foreground="#DDFFFFFF" Margin="0, 0, 0, 15" VerticalAlignment="Bottom" HorizontalAlignment="Center" MinWidth="150" Background="Black" Padding="10,1,10,1" BorderThickness="0"/>
    </Grid>

</Window>